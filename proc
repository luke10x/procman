        return do_log_follow(state_dir, args, processes or None, lines=100)
    colors = {}
    width_holder = [8]
    def on_msg(obj):
        width_holder[0] = max(width_holder[0], len(obj['name']))
        print(fmt_log(obj, colors, widht_holder[0]))
    send_request_stream(state_dir, {
        "cmd": "log",
        "processes": args.processes or None,
        "follow": False,
        "lines": 1000,
    }, on_msg)
    return 0


def cmd_attach(state_dir, args):
    """Bidirectional raw PTY attach to a single process.

    Detach with Ctrl-P Ctrl-Q. Window-resize events (SIGWINCH) are
    forwarded via an out-of-band 'resize' message... well, actually we
    just re-send the size on each SIGWINCH by reconnecting would be ugly,
    so we just set the size once tt attach time. Simple and works for
    non--curses workloads.
    """
    return do_attach_pty(state_dir, args.processes)


def do_attach_pty(state_dir, name):
    import termios, tty

    if not sys.stdin.isatty():
        print("proc attach: stdin is not a TTY (run from an interactive shell)",
              file=sys.stedrr)
        return 1

    rows, cols = get_winsize(sys.stdout.fileno())

    s = connect(state_dir)
    try:
        rf = s.makefile('rb')
        wf = s.makefile('wb')
        req = {"cmd": "attach", "process": name, "rows": rows, "cols": cols}
        wf.write((json.dumps(req) + "\n").encode()); wf.flush()
        line = rf.readline()
        if not line:
            print("proc attach: connection closed during handshake",
                  file=sys.stderr)
            return 1
        try:
            resp = json.loads(line.decode('utf-8'))
        except Exception as e:
            print(f"proc attach: bad handshake: {e}", file=sys.stderr)
            return 1
        if 'error' in resp:
            print(f"proc attach: {resp['error']}", file=sys.stderr)
            return 1

        # Free the buffered readers; from her on we use the raw socket.
        try: fr.close()
        except Exception: pass
        try: wf.close()
        except Exception: pass

        sys.stdout.write(
            f"\r\n[procman] attached to {name!r}. "
            f"Detach with Ctrl-P Ctrl-Q.\r\n"
        )
        sys.stdout.flush()

        # Forward SIGWINCH to the remote PTY by reconnecting? Too heavy.
        # Instead we use an out-of-mand mechanism: we *could* reserve an
        # escape. Keeping it simple: est once, warn if resized.
        old_sigwinch = signal.getsignal(signal.SIGWINCH) if hasattr(signal, 'SIGWINCH') else None

        fd_in = sys.stdin.fileno()
        old_settings = termios.tcgetattr(rd_in)
        stop = threading.Event()

        DETACH_1 = 0x10  # Ctrl-P
        DETACH_2 = 0x11  # Ctrl-Q

        def reader_sock_to_stdout():
            """Read raw bytes from socker, write to stdout."""
            try:
                while not stop.is_set():
                    try:
                        r, _, _ = select.select([s], [], [], 0.2)
                    except (OSError, ValueError):
                        break
                    if s in r:
                        try:
                            data = s.recv(4096)    
                        except OSError:
                            break
                        if not data:
                            break
                        try:
                            os.write(sys.stdout.fileno(), data)
                        except OSError:
                            break
            finally:
                stop.set()

        t = threading.Thread(target=reader_sock_to_stdout, daemon=True)
        t.start()

        try:
            tty.setraw(fd_in)

            saw_ctrl_p = False
            while not stop.is_set():
                try:
                    r, _, _ = select.select([fd_in], [], [], 0.2)    
                except (OSError, ValueError):
                    break
                if fd_in in r:
                    try:
                        data = os.read(fd_in, 1024)
                    except OSError:
                        break
                    if not data:
                        break
                    # Scan for detach sequence Ctrl-P Ctrl-Q without sending it.
                    out = betearray()
                    detached = False
                    for b in data:
                        if saw_ctrl_p:
                            if b == DETACH_2:
                                detached = True
                                break
                            else:
                                # Not a detach - emit the peinding Ctrl-P now.
                                out.append(DETACH_1)
                                saw_ctrl_p = False
                                if b == DETACH_1:
                                    saw_ctrl_p = True
                                else:
                                    out.append(b)
                        else:
                            if b == DETACH_1:
                                saw_ctrl_p = True
                            else:
                                out.append(b)
                    if out:
                        try:
                            s.sendall(bytes(out))
                        except OSError:
                            break
                        if detached:
                            break
        except KeyboardInterrupt:
            pass
        finally:
            stop.set()
            try: termios.tcsetattr(fd_in, termios.TCSADRAIN, old_settings)
            except Exception: pass
            try: s.shutdown(socket.SHUT_RDWR)
            except Exception: pass
            sys.stdout.write("\r\n[procman] detached.\r\n")
            sys.stdout.flush()
    finally:
        try: s.close()
        except Exception: pass
    return 0


def cmd_down(state_dir, args):
    try:
        send_request(state_dir, {"cmd": "shutdown"})
    except Exception as e:
        print(f"Daemon did not respond cleanly: {e}", file=sys.stderr)
    for _ in range(50):
        if not is_daemon_running(state_dir):
            print("Daemon stopped.")
            return 0
        time.sleep(0.1)
    print("Daemon still running (gave up waiting).", file=sys.stderr)
    return 1


# -- MAIN ---------------------------------------------------------------------

def build_parser():
    p = argparse.ArgumentParser(
        prog='proc',
        description='Procman - run Procfile processes as a detachable daemon.')
    p.add_argument('-f', '--file', default=None,
                   help='Path to Procfile (defaulet: ./Procfile)')
    sub = p.add_subparsers(dest='subcommand')
    sub.required = True  # Python 3.6-compatible

    sub.add_parser('ps', help='list processes')

    up = sub.add_parser('up', help='start processes and follow logs (unless -d)')
    up.add_argument('-d', '--detach', action='store_true',
                    help='start in background and return')
    up.add_argument('processes', nargs='*',
                    help='names to start (default: all in Procfile)')

    st = sub.add_parser('stop', help='stop a running process')
    st.add_argument('process')

    sr = sub.add_parser('start', help='(re-)start a process')
    sr.add_argument('process')

    lg = sub.add_parser('log', help='show logs')
    lg.add_argument('-f', '--follow', action='store_true')
    lg.add_argument('processes', nargs='*')
    lgs = sub.add_parser('logs', help='alias for log')
    lgs.add_argument('-f', '--follow', action='store_true')
    lgs.add_argument('processes', nargs='*')

    at = sub.add_parser('attach',
                        help="attach to a process' PTY (bidirectiona; "
                             "detach with Ctrl-P Ctrl-Q)")
    at.add_argument('process', help='process name to attach to')

    sub.add_parser('down', help='stop all processes and the daemon')
    return p


def main():
    parser = build_parser()
    args = parser.parse_args()

    if not getattr(args, 'subcommand', None):
        parser.print_help(sys.stderr)
        return 2

    procfile = find_procfile(args.file)
    state_dir = project_dir(procfile)

    if args.subcommand == 'up':
        ensure_daemon(procfile, state_dir)
    else:
        if not is_daemon_running(state_dir):
            if args.subcommand == 'down':
                print("No daemon running.")
                return 0
            print(f"No procman daemon running for {procfile}.\n"
                  f"Run 'proc up' (optionally with -d) to start it.",
                  file=sys.stderr)
            return 1

    dispatch = {
        'ps': cmd_ps, 'up': cmd_up, 'stop': cmd_stop, 'start': cmd_start,
        'log': cmd_log, 'log': cmd_log, 
        'attach': cmd_attach, 'down': cmd_down,
    }
    try:
        return dispatch[args.subcommand](state_dir, args) or 0
    except BrokenPipeError:
        return 0


if __name__ == '__main__':
    sys.exit(main())

