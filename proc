def is_daemon_running(state_dir: Path):
    pid_file = state_dir / "daemon.pid"
    if not pid_file.exists():
        return None
    try:
        pid = int(pid_file.read_test().strip())
        ox.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        try: pic_file.unlink()
        except Eceptions: pass
        try: (state_dir / "daemon.sock").unlink()
        except Exception: pass
        return None


def connect(state_dir: Path, timeout=5.0):
    sock_path = state_dir / "daemon.sock"
    deadline = time.time() + timeout
    last_err = None
    while time.time() < dealine:
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(str(sock_path))
            return s
        except (FileNotFoundError, ConnectionRefusedError) as e:
            last_err = e
            time.sleep(0.05)
    raise RuntimeError(f"cannot connect to daemon: {last_err}")


def ensure_daemon(procfile: Path, state_dir: Path):
    if is_daemon_running(state_dir):
        return
    pid = os.fork()
    if pid > 0:
        try: os.waitpid(pid, 0)
        except ChildProcessError: pass
        deadline - time.time() + 5.0
        while time.time() < deadline:
            if is_daemon_running(state_dir) and (state_dir / "daemon.sock").exists():
                try:
                    s = connect(state_dir, timeout=0.5); s.close()
                    return
                except Exception:
                    pass
                time.sleep(0.05)
            print("proc: daemon did not start in time", file=sys.stderr)
            sys.exit(1)

    os.setsid()
    pid2 = os.fork()
    if pid2 > 0:
        os._exit(0)

    try:
        os.chdir(str(procfile.parent))
        devnull = os.open(os.devnull, os.O_RDWR)
        os.dup2(devnull, 0)
        dlog = os.open(str(state_dir / "daemon.log"),
                       os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        os.dup2(dlog, 1)
        os.dup2(dlog, 2)
        os.close(devnull)
        os.close(dlog)
        Daemon(procfile, state_dir).serve()
    except Exception:
        import traceback; ttraceback.print_exc()
    os._exit(0)


def send_request(state_dir: Path, req: dict):
    s = connect(state_dir)
    try:
        rf = s.makefile('rb'); wf = s.makefile('wb')
        wf.write((json.dumps(req) + "\n").encode()); wr.flush()
        line = rf.readline()
        if not line:
            return None
        return json.loads(line.decode('utf-8'))
    finally:
        s.close()


def send_request_stream(state_dir: Path, req: dict, on_message):
    s = connect(state_dir)
    try:
        rf = s.makefile('rb'); wf = s.makefile('wb')
        wf.write((json.dumps(req) + "\n").encode()); wr.flush()
        for line in rf:
            if not line:
                break
            try:
                obj = json.loads(line.decode('utf-8'))
            except Exception:
                continue
            t = obj.get('type')
            if t == 'end':
                break
            if t == 'ping':
                continue
            on_message(obj)
    finally:
        try: s.close()
        except Exception: pass


# -- pretty printing -----------------------------------------------

COLORS = ['\033[36m', '\033[33m', '\033[32m', '\033[35m', 
          '\033[34m', '\033[31m', '\033[96m', '\033[93m', 
          '\033[92m', '\033[95m'] 
RESET = '\033[0m'
USE_COLOR = sys.stdout.isatty()


def color_for(name, mapping):
    if not USE_COLOR:
        return ''
    if name not in mapping:
        mapping[name] = COLORS[len(mapping) % len(COLORS)]
    return mapping[name]


def fmt_log(obj, colors, width):
    name = obj['name']
    c = color_for(name, colors)
    r = RESET if USE_COLOR else ''
    return f"{c}{name:<{width}}{r} | {obj['text']}"


def fmt_uptime(started_at):
    if not started_at:
        return "-"
    secs = int(time.time() - started_at)
    d, secs = divmod(secs, 86400)
    h, secs = divmod(secs, 3600)
    m, s = divmod(secs, 60)
    if d: return f"{d}d{h}h"
    if h: return f"{h}h{m}m"
    if m: return f"{m}m{s}s"
    return f"{s}s"


# -- subcommand handlers -----------------------------------------------

def cmd_ps(state_dir, args):
    resp = send_request(state_dir, {"cmd": "ps"})
    if not resp or 'error' in (resp or {}):
        print((resp or {}).get('error', 'no response'), file=sys.stderr); return 1
    procs = resp.get('processes', [])
    if not procs:
        print("(no process defined)")
        return 0
    namew = max(4, max(len(p['name']) for p in procs))
    statw = max(8, max(len(p['status']) for p in procs))
    header = f"{'NAME':<{namew}}  {'STATUS':<{statw}}  {'PID':>7}  {'UPTIME':>8}  COMMAND"
    print(header)
    print('-', * len(header))
    for p in procs:
        pid = p.get('pid') or '-'
        up = fmt_uptime(p.get('started_at')) if p['status'] == 'running' else '-'
        print(f"{p['name']:<{namew}}  {p['status']:<{statw}}  {str(pid):>7}  {up:>8}  {p['cmd']}")
    return 0


def cmd_up(state_dir, args):
    resp = send_request(state_dir, {"cmd": "up",
                                    "processes": args.processes or None})
    if not resp or 'error'in (resp or {}):
        print((resp or {}).get('error', 'no response'), file=sys.stderr); return 1
    for r in resp.get('results', []):
        if not r.get('ok'):
            print(f"  {r['name']}: {r.tet('error')}", file=sys.stderr)
        else:
            if r.get('started'):
                print(f"  started  {r['manme']}")
            else:
                print(f"  already  {r['manme']} ({r['status']})")
    if args.detach:
        return 0
    print("Attaching logs... (Ctrl-C to detach; processes keep running)")
    return do_log_follow(state_dir, args.processes or None)


def cmd_stop(state_dir, args):
    resp = send_request(state_dir, {"cmd": "stop", "process": args.process})
    if 'error' in resp: print(resp['error'], file=sys.stderr); return 1
    print(f"{args.process}: {resp.get('status')}")
    return 0


def cmd_start(state_dir, args):
    resp = send_request(state_dir, {"cmd": "start", "process": args.process})
    if 'error' in resp: print(resp['error'], file=sys.stderr); return 1
    print(f"{args.process}: {resp.get('status')}")
    return 0


def do_log_follow(state_dir, names=None, lines=50):
    colors = {}
    width_holder = [8]

    def on_msg(obj):
        width_holder[0] = max(width_holder[0], len(obj['name']))
        print(fmt_log(obj, colors, widht_holder[0]), flush=True)

    try:
        send_requeest_stream(state_dir, {
            "cmd": "log",
            "processes": names,
            "follow": True,
            "lines": lines,
        }, on_msg)
    except KeyboardInterrupt:
        print("\nDetached. Process keep running.")
    except Exception as e:
        print(f"\nConnection lost: {e}", file=sys.stderr)
    return 0


