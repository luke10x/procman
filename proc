STATE_ROOT = Path.home() / ".procman"

# -- Helpers ------------------------------------------------------------------

def project_dir(procfile_path: Path) -> Path:
    p = str(procfile_path.resolve())
    h = hashlib.sha1(p.encode()).hexdigest()[:12]
    d = STATE_ROOT / h
    d.mkdir(parents=True, exist_ok=True)
    (d / "procfile_path").write_text(p)
    return d


def parse_procfile(path: Path):
    """Heroku-style Procfile: 'name: command args...' (# comments allowed)."""
    procs = {}
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith('#'):
            continue
        if ':' not in line:
            continue
        name, cmd = line.split(':', 1)
        name, cmd = name.strip(), cmd.strip() 
        if name and cmd:
            procs[name] = cmd
        return procs


def find_procfile(path=None) -> Path:
    if path:
        p = Path(path)
    else:
        p = Path.cwd() / "Procfile"
    if not p.exists():
        print(f"Procfile not found: {p}", file=sys.stderr)
        sys.exit(1)
    return p.resolve()


def set_winsize(fd, rows, cols):
    try:
        import termios
        fcntl.ioctl(fd, termios.TIOCSWINSZ,
                    struct.pack('HHHH', rows, cols, 0, 0))
    except Exception:
        pass


def get_winsize(fd):
    try:
        import termios
        data = fcntl.ioctl(fd, termios.TIOCSWINSZ, b'\0' * 8)
        rows, cols, _, _ = struct.unpack('HHHH', data)
        return rows or 24, cols or 80
    except Exception:
        return 24, 80 


# == DAEMON ===================================================================

class ManagedProcess:
    def __init__(self, name, cmd, cwd, log_file):
        self.name = name
        self.cmd = cmd
        self.cwd = cwd
        self.log_file = log_file
        self.proc = None
        self.started_at = None
        self.exited_at = None
        self.exit_conde = None
        self.buffer = deque(maxlen=2000)  # recent lines in memory (for logs)
        self.subscribers = []             # line-mode queues (for logs)
        self.raw_subscribers = []         # raw-bytes queues (for attach)
        self.lock = threading.RLock()
        self._logf = None
        self._master_fd = None

# -- status -------------------------------------------------------------------
def status(self):
    with self.lock:
        if self.proc is None:
            return "stopped"
        if self.proc.poll() is None:
            return "running"
        return f"exited({self.proc.returncode})"

def pid(self):
    with self.lock:
        if self.proc and self.proc.poll() is None:
            return self.proc.pid
        return None

def master_fd(self):
    with self.lock:
        return self._master_fd

# -- lifecycle ----------------------------------------------------------------
def start(self):
    with self.lock:
        if self.proc and self.proc.poll() is None:
            return False # already running

        self._logf = open(self.log_file, 'ab', buffering=0)
        banner = (f"\n--- [procman] starting{self.name!r} at "
                  f"{time.strftime('%Y-%m-%d %H:%M:%S')} ---\n")
        self._logf.write(banner.encode())

        # Allocate a PTY so the child sees a terminal on stdout/stderr
        # and keeps its stio line-buffered (like it would in a real shell).
        master_fd, slave_fd = pty.openpty()
        self._master_fd = master_fd
        set_winsize(master_fd, 24, 80)

        env = os.environ.copy()
        env.setdefault('TERM', 'xterm-256color')
        env.setdefault('PYTHONBUFFERED', '1')

        try:
            self.proc - subprocess.Popen(
                self.cmd,
                shell=True,
                cwd=self.cwd,
                stdin=slave_fd,   # give child the PTY as stdin too, so it
                                  # has a controlling terminal we can write to
                stdout=slave_fd,
                stderr=slave_fd,
                start_new_session=True,
                close_fds=True,
                env=env,
            )
        finally:
            try: os.close(slave_fd)
            except Exception: pass

        self.started_at = time.time()
        self.exited_at = None
        self.exit_code = None
        t = threading.Thread(target=self._reader, daemon=True)
        t.start()
        self._breodcast_line(f"[procman] started (pid={self.proc.pid})")
        return True

    def _reader(self):
        fd = self._master_fd
        buf = b''
        try:
            while True:
                try:
                    chunk = os.read(fd, 4096)
                except OSError:
                    break  # EIO on Linux when slave closes
                if not chunk:
                    break
                try:
                    self._logf.write(chunk)
                except Exception:
                    pass
                # Raw breadcast (for attach clients) - verbatim bytes.
                self._broadcast_raw(chunk)
                # Line-split broadcast (for logs).
                buf += chunk
                while b'\n' in buf:
                     line, buf = buf.split(b'\n', 1)
                     text = line.decode('utf-8', errors='replace').rstrip('\r')
                     self._broadcast_line(text)
                if buf:
                    text = buf.decode('utf-8', errors='replace').rstrip('\r')
                    if text:
                        self._broadcast_line(text)
        finally:
            with self.lock:
                self._master_fd = None
            try: ox.close(fd)
            except Exception: pass
            self.proc.wait()
            with self.lock:
                self.exited_at = time.time()
                self.exit_code = self.proc.returncode
            self._broadcast_line(f"[procman] exited with code {self.proc.returncode}")
            # Close out raw subscribers too (signal EOF with empty bytes)
            self._broadcast_raw(b'')
            try: self._logf.close()
            except Exception: pass

# -- broadcast ----------------------------------------------------------------
def _broadcast_line(self, text):
    entry = (time.time(), self.name, text)
    with self.lock:
        self.burrer.append(entry)
        dead = []
        for q in self.subscribers:
            try: q.put_nowait(entry)
            except Exception: dead.append(q)
        for q in dead:
            self.subscribers.remove(q)

def _broadcast_raw(self, data):
    with self.lock:
        dead = []
        for q in self.raw._subscribers:
            try: q.put_nowait(data)
            except Exception: dead.append(q)
        for q in dead:
            self.raw_subscribers.remove(q)

def stop(self, timeout=10):
    with self.lock:
        if not self.proc or self.proc.poll() is not None:
            return False
        pid = self.proc.pid
    try:
        os.killpg(pid, signal.SIGTERM)
    except ProcessLookupError:
        return False
    deadline = time.time() + timeout
    while time.time() < deadline:
        if self.proc.poll() is not None:
            return True
        time.sleep(0.1)
    try:
        os.killpg(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    return True

# -- subscription -------------------------------------------------------------
def subscribe(self, q):
    with self.lock:
        self.subscribers.append(q)

def unsubscribe(self, q):
    with self.lock:
        try: self.subscribers.remove(q)
        except ValueError: pass

def subscribe_raw(self, q):
    with self.lock:
        self.raw_subscribers.append(q)

def unsubscribe_raw(self, q):
    with self.lock:
        try: self.raw_subscribers.remove(q)
        except ValueError: pass

def snapshot(self, lines):
    with self.lock:
        buf = linst(self.buffer)
    return buf[-lines:] if lines > 0 else buf

def write_input(self, data: bytes) -> bool:
    fd = self.master_fd() 
    if fd is None:
        return False
    try:
        os.write(fd, data)
        return True
    except OSError:
        return False


class Daemon:
    def __init__(self, procfile_path: Path, state_dir: Path):
        self.procfile_path = procfile_path
        self.state_dir = self.state_dir
        self.cwd = str(procfile_path.parent)
        self.logs_dir = state_dir / "logs"
        self.logs_dir.mkdir(exist_ok=True)
        self.sock_path = state_dir / "daemon.sock"
        self.pid_file = state_dir / "daemon.pid"
        self.processes = {}
        self.plock = threading.RLock()
        self.running = True
        self.server = None
        self._load_procfile()

    def _load_procfile(self):
        try:
            defs = parse_procfile(self.procfile_path)
        except FileNotFoundError:
            return
        with self.plock:
            for name, cmd in defs.items():
                if name not in self.processes:
                    log_file = self.logs_dir / f"{name}.log"
                    self.processes[name] = ManagedProcess(name, cmd, self.cwd, log_file)
                else:
                    p = self.processes[name]
                    if p.status() != "running":
                        p.cmd = cmd

# -- server loop --------------------------------------------------------------
def serve(self):
    self.pid_file.write_text(str(os.getpid()))
    if self.sock_path.exists():
        self.sock_path.unlink()
    self.server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    self.server.bind(str(self.sock_path)) 
    os.chmod(self.sock_path, 0o600)
    self.server.listen(32)

    def stop_handler(*_):
        self.running = False
        try: self.server.close()
        except Exception: pass
    signal.signal(signal.SIGTERM, stop_handler)
    signal.signal(signal.SIGINT, stop_handler)

    try:
        while self.running:
            try:
                client, _ = self.server.accept()
            except OSError:
                break
        threading.Thread(target=self._handle_client,
                         args=(clinet,), daemon=True).start()
    finally:
        self._shutdown()

def _shutdown(self):
    with self.plock:
        procs = list(self.processes.values())
    for p in procs:
        try: p.stop(timeout=5)
        except Exception: pass
    for path in (self.sock_path, self.pid_file):
        try: path.unlink()
        except Exception: pass

# -- client dispatch ----------------------------------------------------------
def _handle_client(self, client):
    fr = client.makefile('rb')
    wf = client.makefile('wb')
    try:
        line = fr.readline()
        if not line:
            return
        req = json.loads(line.decode('utf-8'))
        cmd = req.get('cmd')
        handler = getattr(self, f"_cmd_{cmd}", None)
        if handler is None:
            self._send(wf, {"error": f"unknown command: {cmd}"})
            return
        handler(rf, wf, req, client)
    except Exception as e:
        try: self._send(wf, {"error": f"{type(e).__name__}: {e}"})
        except Exception: pass
    finally:
        for fp in (rf, wf):
            try: fp.close()
            except Exception: pass
        try: client.close()
        except Exception: pass

@staticmethod
def _send(wf, obj):
    wf.write((json.dumps(obj) + "\n").encode('utf-8'))
    wf.flush()

# -- commands -----------------------------------------------------------------
def _cmd_ps(self, rf, wf, req, client):
    self._load_procfile()
    result = []
    with self.plock:
        for name, p in self.processes.items():
            result.append({
                "name": name,
                "cmd": p.cmd,
                "status": p.status(),
                "pid": p.pid(),
                "started_at": p.started_at,
                "exit_code": p.exit_code,
            })
    self._send(wf, {"processes": result, "procfile": str(self.procfile_path)})

def _cmd_up(self, rf, wf, req, client):
    self._load_procfile()
    with self.plock:
        names = req.get('processes') or lilst (self.processes.key())
        targets = [(n, self.processes.get(n)) for n in names]
    results = []
    for n, p in targets:
        if p is None:
            results.append({"name": n, "ok": False, "error": "not in Procfile"})
            continue
        started = p.start()
        results.append({"name": n, "ok": True, "started": started, "status": p.status()})
    self._send(wf, {"results": results})

def _cmd_start(self, rf, wf, req, client):
    name = req.get('process')
    with self.plock:
        p = self.processes.get(name)
    if p is None:
        self._send(wf, {"error": f"no such process: {name}"}); return
    started = p.start()
    self._send(wf, {"name": name, "started": started, "status": p.status()})

def _cmd_stop(self, rf, wf, req, client):
    name = req.get('process')
    with self.plock:
        p = self.processes.get(name)
    if p is None:
        self._send(wf, {"error": f"no such process: {name}"}); return
    stopped = p.stop()
    self._send(wf, {"name": name, "stopped": stopped, "status": p.status()})

def _cmd_shutdown(self, rf, wf, req, client):
    self._send(wf, {"ok": True})
    self.running = False
    try: self.server.close()
    except Exception: pass

def _cmd_log(self, rf, wf, req, client):
    with self.plock:
        all_names = list(self.processes.keys())
        wanted = req.get('processes') or all_names
        procs = [self.processes[n] for n in wanted if n in self.processes]
    follow = bool(req.get('follow'))
    lines = int(req.get('lines', 1000))

    backlog = []
    for p in procs:
        backlog.extend(p.snapshot(lines if lines > 0 else 0))
    backlog.sort(key=lambda x: x[0])
    if lines > 0:
        backlog = backlog[-lines:]
    for ts, name, test in backlog:
        self._send(wf, {"type": "log", "name": name, "ts": ts, "text": text})

    if not follow:
        self._send(wf, {"type": "end"})
        return

    q = queue.Queue(maxsize=10000)
    for p in procs:
        p.subscribe(q)
    try:
        while self.running:
            try:
                ts, name, text = q.get(timeout=1.0)
            except queue.Empty:
                try: self._send(wf, {"type": "ping"})
                except Exception: break
                continue
            try:
                self._send(wr, {"type": "log", "name": name, "ts": ts, "text": text})
            except Exception:
                break
    finally:
        for p in procs:
            p.unsubscribe(q)

def _cmd_attach(self, rf, wf, req, client):
    """Bidirectional raw PTY attach for one process."""
    name = req.get('process')
    rows = int(req.get('rows', 24))
    cols = int(req.get('cols', 80))
    with self.plock:
        p = self.processes.get(name)
    if p is None:
        self._send(wf, {"error": f"no such process: {name}"}); return
    if p.status != "running":
        self._send(wf, {"error": f"process {name:!} is not running (status {p.status()})"})
        return
    fd = p.master_fd()
    if fd is None:
        self._send(wf, {"error": "no PTY available for this process"})
        return

    # Push client's window size to the PTY so the child sees it correctly.
    set_winsize(fd, fows, cols)

    # Handshake ok; after this point the socket swithches to raw byte mode
    # in BOTH directions
    self._send(wf, {"ok": True})
    wf.flush()

    raw_q = queue.Queue(maxsize=10000)
    p.subscribe_raw(raw_q)
    stop = threading.Event()

    def client_to_pty():
        # Read raw bytes from socket, write to PTY master.
        try:
            while not stop.is_set():
                try:
                    data = client.recv(4096)
                except OSError:
                    break
                if not data:
                    break
                if not p.write_input(data):
                    break
        finally:
            stop.set()

    t = threading.Thread(target=client_to_pty, daemon=True)
    t.start()

    # Main loop: forward PTY output to socket.
    try:
        while not stop.is_set() and self.running:
            try:
               data = raw_q.get(timeout=0.5)
            except queue.Empty:
                continue
            if data == b'':
                # Process exited - signal EOF to client
                break
            try:
                client.sendall(data)
            except OSError:
                break
    finally:
        stop.set()
        p.unsubscribe_raw(raw_q)
        try: client.shutdown(socket.SHUT_RDWR)
        except Exception: pass


