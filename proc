#!/usr/bin/env python3
"""
Procman (proc) - run Procfile prpcesses as a detachable daemon.

Subcommands:
    proc [-f PROCFILE] up [-d] [PROC ...]     start processes (attach unless -d)
    proc [-f PROCFILE] ps                     list processes
    proc [-f PROCFILE] start PROC             (re)start a single process
    proc [-f PROCFILE] stop PROC              stop a single process
    proc [-f PROCFILE] log [-f] [PROC ...]    show logs (optionally -f to follow)
    proc [-f PROCFILE] attach PROC            attach to a process' PTY (bidirectional)
    proc [-f PROCFILE] down                   stop all processes and daemon
    
Attach-detach sequence: Ctrl-P Ctrl-Q (Docker-style; safe for most programs).

State lives in ~/.procman/<hash-of-procfile-path>
"""

import os
import sys
import pty
import json
import time
