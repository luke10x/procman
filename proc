#!/usr/bin/env python3
"""
Procman (proc) - run Procfile processes as a detachable daemon.

Subcommands:
    proc [-f PROCFILE] up [-d] [PROC ...]     start processes (attach unless -d)
    proc [-f PROCFILE] ps                     list processes
    proc [-f PROCFILE] start PROC             (re)start a single process
    proc [-f PROCFILE] stop PROC              stop a single process
    proc [-f PROCFILE] log [-f] [PROC ...]    show logs (optionally -f to follow)
    proc [-f PROCFILE] attach PROC            attach to a process' PTY (bidirectional)
    proc [-f PROCFILE] down                   stop all processes and daemon

Attach-detach sequence: Ctrl-P Ctrl-Q (Docker-style; safe for most programs).

State lives in ~/.procman/<hash-of-procfile-path>.
"""

import argparse
import fcntl
import hashlib
import json
import os
import pty
import queue
import select
import signal
import socket
import struct
import subprocess
import sys
import threading
import time
from collections import deque
from pathlib import Path

STATE_ROOT = Path(os.environ.get("PROCMAN_STATE_ROOT", Path.home() / ".procman"))


# -- Helpers ------------------------------------------------------------------

def project_dir(procfile_path: Path) -> Path:
    resolved = str(procfile_path.resolve())
    digest = hashlib.sha1(resolved.encode()).hexdigest()[:12]
    state_dir = STATE_ROOT / digest
    state_dir.mkdir(parents=True, exist_ok=True)
    (state_dir / "procfile_path").write_text(resolved)
    return state_dir


def parse_procfile(path: Path):
    """Parse Heroku-style Procfile lines: 'name: command args...'."""
    procs = {}
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or ":" not in line:
            continue
        name, cmd = line.split(":", 1)
        name, cmd = name.strip(), cmd.strip()
        if name and cmd:
            procs[name] = cmd
    return procs


def find_procfile(path=None) -> Path:
    procfile = Path(path) if path else Path.cwd() / "Procfile"
    if not procfile.exists():
        print(f"Procfile not found: {procfile}", file=sys.stderr)
        sys.exit(1)
    return procfile.resolve()


def set_winsize(fd, rows, cols):
    try:
        import termios
        fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))
    except Exception:
        pass


def get_winsize(fd):
    try:
        import termios
        data = fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\0" * 8)
        rows, cols, _, _ = struct.unpack("HHHH", data)
        return rows or 24, cols or 80
    except Exception:
        return 24, 80


# == DAEMON ===================================================================

class ManagedProcess:
    def __init__(self, name, cmd, cwd, log_file):
        self.name = name
        self.cmd = cmd
        self.cwd = cwd
        self.log_file = log_file
        self.proc = None
        self.started_at = None
        self.exited_at = None
        self.exit_code = None
        self.buffer = deque(maxlen=2000)
        self.subscribers = []
        self.raw_subscribers = []
        self.lock = threading.RLock()
        self._logf = None
        self._master_fd = None

    def status(self):
        with self.lock:
            if self.proc is None:
                return "stopped"
            if self.proc.poll() is None:
                return "running"
            return f"exited({self.proc.returncode})"

    def pid(self):
        with self.lock:
            if self.proc and self.proc.poll() is None:
                return self.proc.pid
        return None

    def master_fd(self):
        with self.lock:
            return self._master_fd

    def start(self):
        with self.lock:
            if self.proc and self.proc.poll() is None:
                return False

            self.log_file.parent.mkdir(parents=True, exist_ok=True)
            self._logf = open(self.log_file, "ab", buffering=0)
            banner = (
                f"\n--- [procman] starting {self.name!r} at "
                f"{time.strftime('%Y-%m-%d %H:%M:%S')} ---\n"
            )
            self._logf.write(banner.encode())

            master_fd, slave_fd = pty.openpty()
            self._master_fd = master_fd
            set_winsize(master_fd, 24, 80)

            env = os.environ.copy()
            env.setdefault("TERM", "xterm-256color")
            env.setdefault("PYTHONUNBUFFERED", "1")

            try:
                self.proc = subprocess.Popen(
                    self.cmd,
                    shell=True,
                    cwd=self.cwd,
                    stdin=slave_fd,
                    stdout=slave_fd,
                    stderr=slave_fd,
                    start_new_session=True,
                    close_fds=True,
                    env=env,
                )
            finally:
                try:
                    os.close(slave_fd)
                except Exception:
                    pass

            self.started_at = time.time()
            self.exited_at = None
            self.exit_code = None
            threading.Thread(target=self._reader, daemon=True).start()
            self._broadcast_line(f"[procman] started (pid={self.proc.pid})")
            return True

    def _reader(self):
        fd = self._master_fd
        buf = b""
        try:
            while True:
                try:
                    chunk = os.read(fd, 4096)
                except OSError:
                    break
                if not chunk:
                    break
                try:
                    self._logf.write(chunk)
                except Exception:
                    pass
                self._broadcast_raw(chunk)
                buf += chunk
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    text = line.decode("utf-8", errors="replace").rstrip("\r")
                    self._broadcast_line(text)
            if buf:
                text = buf.decode("utf-8", errors="replace").rstrip("\r")
                if text:
                    self._broadcast_line(text)
        finally:
            with self.lock:
                self._master_fd = None
            try:
                os.close(fd)
            except Exception:
                pass
            try:
                self.proc.wait()
            except Exception:
                pass
            with self.lock:
                self.exited_at = time.time()
                self.exit_code = self.proc.returncode if self.proc else None
            self._broadcast_line(f"[procman] exited with code {self.exit_code}")
            self._broadcast_raw(b"")
            try:
                self._logf.close()
            except Exception:
                pass

    def _broadcast_line(self, text):
        entry = (time.time(), self.name, text)
        with self.lock:
            self.buffer.append(entry)
            dead = []
            for subscriber in self.subscribers:
                try:
                    subscriber.put_nowait(entry)
                except Exception:
                    dead.append(subscriber)
            for subscriber in dead:
                self.subscribers.remove(subscriber)

    def _broadcast_raw(self, data):
        with self.lock:
            dead = []
            for subscriber in self.raw_subscribers:
                try:
                    subscriber.put_nowait(data)
                except Exception:
                    dead.append(subscriber)
            for subscriber in dead:
                self.raw_subscribers.remove(subscriber)

    def stop(self, timeout=10):
        with self.lock:
            if not self.proc or self.proc.poll() is not None:
                return False
            pid = self.proc.pid
        try:
            os.killpg(pid, signal.SIGTERM)
        except ProcessLookupError:
            return False
        deadline = time.time() + timeout
        while time.time() < deadline:
            if self.proc.poll() is not None:
                return True
            time.sleep(0.1)
        try:
            os.killpg(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        return True

    def subscribe(self, subscriber):
        with self.lock:
            self.subscribers.append(subscriber)

    def unsubscribe(self, subscriber):
        with self.lock:
            try:
                self.subscribers.remove(subscriber)
            except ValueError:
                pass

    def subscribe_raw(self, subscriber):
        with self.lock:
            self.raw_subscribers.append(subscriber)

    def unsubscribe_raw(self, subscriber):
        with self.lock:
            try:
                self.raw_subscribers.remove(subscriber)
            except ValueError:
                pass

    def snapshot(self, lines):
        with self.lock:
            buf = list(self.buffer)
        return buf[-lines:] if lines > 0 else buf

    def write_input(self, data: bytes) -> bool:
        fd = self.master_fd()
        if fd is None:
            return False
        try:
            os.write(fd, data)
            return True
        except OSError:
            return False


class Daemon:
    def __init__(self, procfile_path: Path, state_dir: Path):
        self.procfile_path = procfile_path
        self.state_dir = state_dir
        self.cwd = str(procfile_path.parent)
        self.logs_dir = state_dir / "logs"
        self.logs_dir.mkdir(exist_ok=True)
        self.sock_path = state_dir / "daemon.sock"
        self.pid_file = state_dir / "daemon.pid"
        self.processes = {}
        self.plock = threading.RLock()
        self.running = True
        self.server = None
        self._load_procfile()

    def _load_procfile(self):
        try:
            defs = parse_procfile(self.procfile_path)
        except FileNotFoundError:
            return
        with self.plock:
            for name, cmd in defs.items():
                if name not in self.processes:
                    log_file = self.logs_dir / f"{name}.log"
                    self.processes[name] = ManagedProcess(name, cmd, self.cwd, log_file)
                else:
                    process = self.processes[name]
                    if process.status() != "running":
                        process.cmd = cmd

    def serve(self):
        self.pid_file.write_text(str(os.getpid()))
        if self.sock_path.exists():
            self.sock_path.unlink()
        self.server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.server.bind(str(self.sock_path))
        os.chmod(self.sock_path, 0o600)
        self.server.listen(32)

        def stop_handler(*_):
            self.running = False
            try:
                self.server.close()
            except Exception:
                pass

        signal.signal(signal.SIGTERM, stop_handler)
        signal.signal(signal.SIGINT, stop_handler)

        try:
            while self.running:
                try:
                    client, _ = self.server.accept()
                except OSError:
                    break
                threading.Thread(
                    target=self._handle_client,
                    args=(client,),
                    daemon=True,
                ).start()
        finally:
            self._shutdown()

    def _shutdown(self):
        with self.plock:
            procs = list(self.processes.values())
        for process in procs:
            try:
                process.stop(timeout=5)
            except Exception:
                pass
        for path in (self.sock_path, self.pid_file):
            try:
                path.unlink()
            except Exception:
                pass

    def _handle_client(self, client):
        rf = client.makefile("rb")
        wf = client.makefile("wb")
        try:
            line = rf.readline()
            if not line:
                return
            req = json.loads(line.decode("utf-8"))
            cmd = req.get("cmd")
            handler = getattr(self, f"_cmd_{cmd}", None)
            if handler is None:
                self._send(wf, {"error": f"unknown command: {cmd}"})
                return
            handler(rf, wf, req, client)
        except Exception as exc:
            try:
                self._send(wf, {"error": f"{type(exc).__name__}: {exc}"})
            except Exception:
                pass
        finally:
            for fp in (rf, wf):
                try:
                    fp.close()
                except Exception:
                    pass
            try:
                client.close()
            except Exception:
                pass

    @staticmethod
    def _send(wf, obj):
        wf.write((json.dumps(obj) + "\n").encode("utf-8"))
        wf.flush()

    def _cmd_ps(self, rf, wf, req, client):
        self._load_procfile()
        result = []
        with self.plock:
            for name, process in self.processes.items():
                result.append({
                    "name": name,
                    "cmd": process.cmd,
                    "status": process.status(),
                    "pid": process.pid(),
                    "started_at": process.started_at,
                    "exit_code": process.exit_code,
                })
        self._send(wf, {"processes": result, "procfile": str(self.procfile_path)})

    def _cmd_up(self, rf, wf, req, client):
        self._load_procfile()
        with self.plock:
            names = req.get("processes") or list(self.processes.keys())
            targets = [(name, self.processes.get(name)) for name in names]
        results = []
        for name, process in targets:
            if process is None:
                results.append({"name": name, "ok": False, "error": "not in Procfile"})
                continue
            started = process.start()
            results.append({
                "name": name,
                "ok": True,
                "started": started,
                "status": process.status(),
            })
        self._send(wf, {"results": results})

    def _cmd_start(self, rf, wf, req, client):
        name = req.get("process")
        with self.plock:
            process = self.processes.get(name)
        if process is None:
            self._send(wf, {"error": f"no such process: {name}"})
            return
        started = process.start()
        self._send(wf, {"name": name, "started": started, "status": process.status()})

    def _cmd_stop(self, rf, wf, req, client):
        name = req.get("process")
        with self.plock:
            process = self.processes.get(name)
        if process is None:
            self._send(wf, {"error": f"no such process: {name}"})
            return
        stopped = process.stop()
        self._send(wf, {"name": name, "stopped": stopped, "status": process.status()})

    def _cmd_shutdown(self, rf, wf, req, client):
        self._send(wf, {"ok": True})
        self.running = False
        try:
            self.server.close()
        except Exception:
            pass

    def _cmd_log(self, rf, wf, req, client):
        with self.plock:
            all_names = list(self.processes.keys())
            wanted = req.get("processes") or all_names
            procs = [self.processes[name] for name in wanted if name in self.processes]
        follow = bool(req.get("follow"))
        lines = int(req.get("lines", 1000))

        backlog = []
        for process in procs:
            backlog.extend(process.snapshot(lines if lines > 0 else 0))
        backlog.sort(key=lambda item: item[0])
        if lines > 0:
            backlog = backlog[-lines:]
        for ts, name, text in backlog:
            self._send(wf, {"type": "log", "name": name, "ts": ts, "text": text})

        if not follow:
            self._send(wf, {"type": "end"})
            return

        messages = queue.Queue(maxsize=10000)
        for process in procs:
            process.subscribe(messages)
        try:
            while self.running:
                try:
                    ts, name, text = messages.get(timeout=1.0)
                except queue.Empty:
                    try:
                        self._send(wf, {"type": "ping"})
                    except Exception:
                        break
                    continue
                try:
                    self._send(wf, {"type": "log", "name": name, "ts": ts, "text": text})
                except Exception:
                    break
        finally:
            for process in procs:
                process.unsubscribe(messages)

    def _cmd_attach(self, rf, wf, req, client):
        name = req.get("process")
        rows = int(req.get("rows", 24))
        cols = int(req.get("cols", 80))
        with self.plock:
            process = self.processes.get(name)
        if process is None:
            self._send(wf, {"error": f"no such process: {name}"})
            return
        if process.status() != "running":
            self._send(wf, {"error": f"process {name!r} is not running (status {process.status()})"})
            return
        fd = process.master_fd()
        if fd is None:
            self._send(wf, {"error": "no PTY available for this process"})
            return

        set_winsize(fd, rows, cols)
        self._send(wf, {"ok": True})
        wf.flush()

        raw_messages = queue.Queue(maxsize=10000)
        process.subscribe_raw(raw_messages)
        stop = threading.Event()

        def client_to_pty():
            try:
                while not stop.is_set():
                    try:
                        data = client.recv(4096)
                    except OSError:
                        break
                    if not data:
                        break
                    if not process.write_input(data):
                        break
            finally:
                stop.set()

        threading.Thread(target=client_to_pty, daemon=True).start()

        try:
            while not stop.is_set() and self.running:
                try:
                    data = raw_messages.get(timeout=0.5)
                except queue.Empty:
                    continue
                if data == b"":
                    break
                try:
                    client.sendall(data)
                except OSError:
                    break
        finally:
            stop.set()
            process.unsubscribe_raw(raw_messages)
            try:
                client.shutdown(socket.SHUT_RDWR)
            except Exception:
                pass


# == CLIENT ===================================================================

def is_daemon_running(state_dir: Path):
    pid_file = state_dir / "daemon.pid"
    if not pid_file.exists():
        return None
    try:
        pid = int(pid_file.read_text().strip())
        os.kill(pid, 0)
        return pid
    except PermissionError:
        return pid
    except (OSError, ValueError):
        try:
            pid_file.unlink()
        except Exception:
            pass
        try:
            (state_dir / "daemon.sock").unlink()
        except Exception:
            pass
        return None


def connect(state_dir: Path, timeout=5.0):
    sock_path = state_dir / "daemon.sock"
    deadline = time.time() + timeout
    last_err = None
    while time.time() < deadline:
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.connect(str(sock_path))
            return sock
        except (FileNotFoundError, ConnectionRefusedError) as exc:
            last_err = exc
            time.sleep(0.05)
    raise RuntimeError(f"cannot connect to daemon: {last_err}")


def ensure_daemon(procfile: Path, state_dir: Path):
    if is_daemon_running(state_dir):
        return

    pid = os.fork()
    if pid > 0:
        try:
            os.waitpid(pid, 0)
        except ChildProcessError:
            pass
        deadline = time.time() + 5.0
        while time.time() < deadline:
            if is_daemon_running(state_dir) and (state_dir / "daemon.sock").exists():
                try:
                    sock = connect(state_dir, timeout=0.5)
                    sock.close()
                    return
                except Exception:
                    pass
            time.sleep(0.05)
        print("proc: daemon did not start in time", file=sys.stderr)
        sys.exit(1)

    os.setsid()
    pid2 = os.fork()
    if pid2 > 0:
        os._exit(0)

    try:
        os.chdir(str(procfile.parent))
        devnull = os.open(os.devnull, os.O_RDWR)
        os.dup2(devnull, 0)
        dlog = os.open(
            str(state_dir / "daemon.log"),
            os.O_WRONLY | os.O_CREAT | os.O_APPEND,
            0o600,
        )
        os.dup2(dlog, 1)
        os.dup2(dlog, 2)
        os.close(devnull)
        os.close(dlog)
        Daemon(procfile, state_dir).serve()
    except Exception:
        import traceback
        traceback.print_exc()
    os._exit(0)


def send_request(state_dir: Path, req: dict):
    sock = connect(state_dir)
    try:
        rf = sock.makefile("rb")
        wf = sock.makefile("wb")
        wf.write((json.dumps(req) + "\n").encode())
        wf.flush()
        line = rf.readline()
        if not line:
            return None
        return json.loads(line.decode("utf-8"))
    finally:
        sock.close()


def send_request_stream(state_dir: Path, req: dict, on_message):
    sock = connect(state_dir)
    try:
        rf = sock.makefile("rb")
        wf = sock.makefile("wb")
        wf.write((json.dumps(req) + "\n").encode())
        wf.flush()
        for line in rf:
            if not line:
                break
            try:
                obj = json.loads(line.decode("utf-8"))
            except Exception:
                continue
            msg_type = obj.get("type")
            if msg_type == "end":
                break
            if msg_type == "ping":
                continue
            on_message(obj)
    finally:
        try:
            sock.close()
        except Exception:
            pass


# -- pretty printing ----------------------------------------------------------

COLORS = [
    "\033[36m", "\033[33m", "\033[32m", "\033[35m", "\033[34m",
    "\033[31m", "\033[96m", "\033[93m", "\033[92m", "\033[95m",
]
RESET = "\033[0m"
USE_COLOR = sys.stdout.isatty()


def color_for(name, mapping):
    if not USE_COLOR:
        return ""
    if name not in mapping:
        mapping[name] = COLORS[len(mapping) % len(COLORS)]
    return mapping[name]


def fmt_log(obj, colors, width):
    name = obj["name"]
    color = color_for(name, colors)
    reset = RESET if USE_COLOR else ""
    return f"{color}{name:<{width}}{reset} | {obj['text']}"


def fmt_uptime(started_at):
    if not started_at:
        return "-"
    secs = int(time.time() - started_at)
    days, secs = divmod(secs, 86400)
    hours, secs = divmod(secs, 3600)
    minutes, seconds = divmod(secs, 60)
    if days:
        return f"{days}d{hours}h"
    if hours:
        return f"{hours}h{minutes}m"
    if minutes:
        return f"{minutes}m{seconds}s"
    return f"{seconds}s"


# -- subcommand handlers ------------------------------------------------------

def cmd_ps(state_dir, args):
    resp = send_request(state_dir, {"cmd": "ps"})
    if not resp or "error" in (resp or {}):
        print((resp or {}).get("error", "no response"), file=sys.stderr)
        return 1
    procs = resp.get("processes", [])
    if not procs:
        print("(no process defined)")
        return 0
    namew = max(4, max(len(process["name"]) for process in procs))
    statw = max(8, max(len(process["status"]) for process in procs))
    header = f"{'NAME':<{namew}}  {'STATUS':<{statw}}  {'PID':>7}  {'UPTIME':>8}  COMMAND"
    print(header)
    print("-" * len(header))
    for process in procs:
        pid = process.get("pid") or "-"
        up = fmt_uptime(process.get("started_at")) if process["status"] == "running" else "-"
        print(
            f"{process['name']:<{namew}}  {process['status']:<{statw}}  "
            f"{str(pid):>7}  {up:>8}  {process['cmd']}"
        )
    return 0


def cmd_up(state_dir, args):
    resp = send_request(state_dir, {
        "cmd": "up",
        "processes": args.processes or None,
    })
    if not resp or "error" in (resp or {}):
        print((resp or {}).get("error", "no response"), file=sys.stderr)
        return 1
    for result in resp.get("results", []):
        if not result.get("ok"):
            print(f"  {result['name']}: {result.get('error')}", file=sys.stderr)
        elif result.get("started"):
            print(f"  started  {result['name']}")
        else:
            print(f"  already  {result['name']} ({result['status']})")
    if args.detach:
        return 0
    print("Attaching logs... (Ctrl-C to detach; processes keep running)")
    return do_log_follow(state_dir, args.processes or None)


def cmd_stop(state_dir, args):
    resp = send_request(state_dir, {"cmd": "stop", "process": args.process})
    if not resp or "error" in resp:
        print((resp or {}).get("error", "no response"), file=sys.stderr)
        return 1
    print(f"{args.process}: {resp.get('status')}")
    return 0


def cmd_start(state_dir, args):
    resp = send_request(state_dir, {"cmd": "start", "process": args.process})
    if not resp or "error" in resp:
        print((resp or {}).get("error", "no response"), file=sys.stderr)
        return 1
    print(f"{args.process}: {resp.get('status')}")
    return 0


def do_log_follow(state_dir, names=None, lines=50):
    colors = {}
    width_holder = [8]

    def on_msg(obj):
        width_holder[0] = max(width_holder[0], len(obj["name"]))
        print(fmt_log(obj, colors, width_holder[0]), flush=True)

    try:
        send_request_stream(state_dir, {
            "cmd": "log",
            "processes": names,
            "follow": True,
            "lines": lines,
        }, on_msg)
    except KeyboardInterrupt:
        print("\nDetached. Processes keep running.")
    except Exception as exc:
        print(f"\nConnection lost: {exc}", file=sys.stderr)
    return 0


def cmd_log(state_dir, args):
    if args.follow:
        return do_log_follow(state_dir, args.processes or None, lines=100)
    colors = {}
    width_holder = [8]

    def on_msg(obj):
        width_holder[0] = max(width_holder[0], len(obj["name"]))
        print(fmt_log(obj, colors, width_holder[0]))

    send_request_stream(state_dir, {
        "cmd": "log",
        "processes": args.processes or None,
        "follow": False,
        "lines": 1000,
    }, on_msg)
    return 0


def cmd_attach(state_dir, args):
    return do_attach_pty(state_dir, args.process)


def do_attach_pty(state_dir, name):
    import termios
    import tty

    if not sys.stdin.isatty():
        print("proc attach: stdin is not a TTY (run from an interactive shell)", file=sys.stderr)
        return 1

    rows, cols = get_winsize(sys.stdout.fileno())
    sock = connect(state_dir)
    try:
        rf = sock.makefile("rb")
        wf = sock.makefile("wb")
        req = {"cmd": "attach", "process": name, "rows": rows, "cols": cols}
        wf.write((json.dumps(req) + "\n").encode())
        wf.flush()
        line = rf.readline()
        if not line:
            print("proc attach: connection closed during handshake", file=sys.stderr)
            return 1
        try:
            resp = json.loads(line.decode("utf-8"))
        except Exception as exc:
            print(f"proc attach: bad handshake: {exc}", file=sys.stderr)
            return 1
        if "error" in resp:
            print(f"proc attach: {resp['error']}", file=sys.stderr)
            return 1

        try:
            rf.close()
        except Exception:
            pass
        try:
            wf.close()
        except Exception:
            pass

        sys.stdout.write(
            f"\r\n[procman] attached to {name!r}. Detach with Ctrl-P Ctrl-Q.\r\n"
        )
        sys.stdout.flush()

        fd_in = sys.stdin.fileno()
        old_settings = termios.tcgetattr(fd_in)
        stop = threading.Event()
        detach_1 = 0x10
        detach_2 = 0x11

        def reader_sock_to_stdout():
            try:
                while not stop.is_set():
                    try:
                        ready, _, _ = select.select([sock], [], [], 0.2)
                    except (OSError, ValueError):
                        break
                    if sock in ready:
                        try:
                            data = sock.recv(4096)
                        except OSError:
                            break
                        if not data:
                            break
                        try:
                            os.write(sys.stdout.fileno(), data)
                        except OSError:
                            break
            finally:
                stop.set()

        threading.Thread(target=reader_sock_to_stdout, daemon=True).start()

        try:
            tty.setraw(fd_in)
            saw_ctrl_p = False
            while not stop.is_set():
                try:
                    ready, _, _ = select.select([fd_in], [], [], 0.2)
                except (OSError, ValueError):
                    break
                if fd_in not in ready:
                    continue
                try:
                    data = os.read(fd_in, 1024)
                except OSError:
                    break
                if not data:
                    break

                out = bytearray()
                detached = False
                for byte in data:
                    if saw_ctrl_p:
                        if byte == detach_2:
                            detached = True
                            break
                        out.append(detach_1)
                        saw_ctrl_p = byte == detach_1
                        if not saw_ctrl_p:
                            out.append(byte)
                    elif byte == detach_1:
                        saw_ctrl_p = True
                    else:
                        out.append(byte)
                if out:
                    try:
                        sock.sendall(bytes(out))
                    except OSError:
                        break
                if detached:
                    break
        except KeyboardInterrupt:
            pass
        finally:
            stop.set()
            try:
                termios.tcsetattr(fd_in, termios.TCSADRAIN, old_settings)
            except Exception:
                pass
            try:
                sock.shutdown(socket.SHUT_RDWR)
            except Exception:
                pass
            sys.stdout.write("\r\n[procman] detached.\r\n")
            sys.stdout.flush()
    finally:
        try:
            sock.close()
        except Exception:
            pass
    return 0


def cmd_down(state_dir, args):
    try:
        send_request(state_dir, {"cmd": "shutdown"})
    except Exception as exc:
        print(f"Daemon did not respond cleanly: {exc}", file=sys.stderr)
    for _ in range(50):
        if not is_daemon_running(state_dir):
            print("Daemon stopped.")
            return 0
        time.sleep(0.1)
    print("Daemon still running (gave up waiting).", file=sys.stderr)
    return 1


# -- MAIN ---------------------------------------------------------------------

def build_parser():
    parser = argparse.ArgumentParser(
        prog="proc",
        description="Procman - run Procfile processes as a detachable daemon.",
    )
    parser.add_argument("-f", "--file", default=None, help="Path to Procfile (default: ./Procfile)")
    sub = parser.add_subparsers(dest="subcommand")
    sub.required = True

    sub.add_parser("ps", help="list processes")

    up = sub.add_parser("up", help="start processes and follow logs (unless -d)")
    up.add_argument("-d", "--detach", action="store_true", help="start in background and return")
    up.add_argument("processes", nargs="*", help="names to start (default: all in Procfile)")

    stop = sub.add_parser("stop", help="stop a running process")
    stop.add_argument("process")

    start = sub.add_parser("start", help="(re-)start a process")
    start.add_argument("process")

    log = sub.add_parser("log", help="show logs")
    log.add_argument("-f", "--follow", action="store_true")
    log.add_argument("processes", nargs="*")

    logs = sub.add_parser("logs", help="alias for log")
    logs.add_argument("-f", "--follow", action="store_true")
    logs.add_argument("processes", nargs="*")

    attach = sub.add_parser(
        "attach",
        help="attach to a process' PTY (bidirectional; detach with Ctrl-P Ctrl-Q)",
    )
    attach.add_argument("process", help="process name to attach to")

    sub.add_parser("down", help="stop all processes and the daemon")
    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()
    procfile = find_procfile(args.file)
    state_dir = project_dir(procfile)

    if args.subcommand == "up":
        ensure_daemon(procfile, state_dir)
    elif not is_daemon_running(state_dir):
        if args.subcommand == "down":
            print("No daemon running.")
            return 0
        print(
            f"No procman daemon running for {procfile}.\n"
            "Run 'proc up' (optionally with -d) to start it.",
            file=sys.stderr,
        )
        return 1

    dispatch = {
        "ps": cmd_ps,
        "up": cmd_up,
        "stop": cmd_stop,
        "start": cmd_start,
        "log": cmd_log,
        "logs": cmd_log,
        "attach": cmd_attach,
        "down": cmd_down,
    }
    try:
        return dispatch[args.subcommand](state_dir, args) or 0
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
